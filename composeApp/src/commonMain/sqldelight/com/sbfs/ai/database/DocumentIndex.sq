CREATE TABLE IF NOT EXISTS document_index (
    id           TEXT    NOT NULL PRIMARY KEY,
    path         TEXT    NOT NULL UNIQUE,
    filename     TEXT    NOT NULL,
    title        TEXT    NOT NULL,
    lastModified INTEGER NOT NULL,
    fileSize     INTEGER NOT NULL,
    indexedAt    INTEGER NOT NULL,
    chunkCount   INTEGER NOT NULL DEFAULT 0,
    status       TEXT    NOT NULL,
    source       TEXT    NOT NULL
);

getAll:
SELECT * FROM document_index;

getByPath:
SELECT * FROM document_index WHERE path = :path;

getById:
SELECT * FROM document_index WHERE id = :id;

insert:
INSERT OR REPLACE INTO document_index VALUES ?;

updateStatus:
UPDATE document_index
SET status = :status, chunkCount = :chunkCount, indexedAt = :indexedAt
WHERE id = :id;

deleteById:
DELETE FROM document_index WHERE id = :id;
