CREATE TABLE IF NOT EXISTS sessionMemory (
    session_id TEXT NOT NULL,
    data TEXT NOT NULL,
    PRIMARY KEY (session_id, data)
);

getAll:
SELECT * FROM sessionMemory WHERE session_id = :session_id;

insert:
INSERT OR REPLACE INTO sessionMemory VALUES ?;

delete:
DELETE FROM sessionMemory WHERE session_id = :session_id AND data = :data;

clear:
DELETE FROM sessionMemory WHERE session_id = :session_id;