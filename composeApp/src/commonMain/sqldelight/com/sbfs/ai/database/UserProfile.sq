import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS user_profile (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT,
    isCurrent INTEGER AS Boolean NOT NULL,
    preferences TEXT NOT NULL, -- JSON string
    limitationsForLLM TEXT NOT NULL, -- JSON string
    additionalInfo TEXT
);

getCurrentUserProfile:
SELECT * FROM user_profile WHERE isCurrent = 1;

getAllProfiles:
SELECT * FROM user_profile;

removeCurrent:
UPDATE user_profile SET isCurrent = 0;

insertOrUpdateProfile:
INSERT OR REPLACE INTO user_profile VALUES ?;