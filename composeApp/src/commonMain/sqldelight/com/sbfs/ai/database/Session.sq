CREATE TABLE IF NOT EXISTS session (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    settings_data TEXT NOT NULL,
    totalToken INTEGER
);

getAll:
SELECT * FROM session;

getByKey:
SELECT * FROM session WHERE id = :id;

insert:
INSERT OR REPLACE INTO session VALUES ?;

updateSettings:
UPDATE session SET title = :title, updated_at = :update_time, settings_data = :data, totalToken = :totalToken WHERE id =:id;

deleteTokenInfo:
UPDATE session SET id =:id, totalToken = NULL WHERE id =:id;

deleteById:
DELETE FROM session WHERE id = :id;

deleteAll:
DELETE FROM session;