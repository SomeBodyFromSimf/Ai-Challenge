CREATE TABLE IF NOT EXISTS document_chunk (
    id          TEXT    NOT NULL PRIMARY KEY,
    documentId  TEXT    NOT NULL,
    chunkIndex  INTEGER NOT NULL,
    content     TEXT    NOT NULL,
    tokenCount  INTEGER NOT NULL DEFAULT 0,
    embedding   BLOB                         -- FloatArray как ByteArray; null если Ollama недоступна
);

getByDocumentId:
SELECT * FROM document_chunk WHERE documentId = :documentId ORDER BY chunkIndex;

getAll:
SELECT * FROM document_chunk ORDER BY documentId, chunkIndex;

insert:
INSERT INTO document_chunk VALUES ?;

deleteByDocumentId:
DELETE FROM document_chunk WHERE documentId = :documentId;
