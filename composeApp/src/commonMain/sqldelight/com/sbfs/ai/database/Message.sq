CREATE TABLE IF NOT EXISTS message (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    usedToken INTEGER,
    cost TEXT
);

getAll:
SELECT * FROM message;

getByKey:
SELECT * FROM message WHERE session_id = :id;

insert:
INSERT OR REPLACE INTO message VALUES ?;

update:
UPDATE message SET usedToken = :usedToken WHERE id = :id;

deleteByKey:
DELETE FROM message WHERE session_id = :id;